# Copy this file to a local file ending in .secrets.env, such as local.secrets.env.
# Real *.secrets.env files are ignored by git.

DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54322/postgres"

# Optional live providers. The app works without these using deterministic mock providers.
BRAVE_SEARCH_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENROUTER_API_KEY=""
