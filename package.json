{
  "name": "@polyvise/core",
  "version": "0.4.0",
  "description": "Framework-neutral multi-agent debate engine, schemas, providers, and artifact contracts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyvise/polyvise-core.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./consensus/*": {
      "types": "./dist/consensus/*.d.ts",
      "import": "./dist/consensus/*.js",
      "default": "./dist/consensus/*.js"
    },
    "./debate/*": {
      "types": "./dist/debate/*.d.ts",
      "import": "./dist/debate/*.js",
      "default": "./dist/debate/*.js"
    },
    "./panel/*": {
      "types": "./dist/panel/*.d.ts",
      "import": "./dist/panel/*.js",
      "default": "./dist/panel/*.js"
    },
    "./runs/*": {
      "types": "./dist/runs/*.d.ts",
      "import": "./dist/runs/*.js",
      "default": "./dist/runs/*.js"
    },
    "./models/*": {
      "types": "./dist/models/*.d.ts",
      "import": "./dist/models/*.js",
      "default": "./dist/models/*.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js",
      "default": "./dist/providers/*.js"
    },
    "./publishing/*": {
      "types": "./dist/publishing/*.d.ts",
      "import": "./dist/publishing/*.js",
      "default": "./dist/publishing/*.js"
    },
    "./workflows/*": {
      "types": "./dist/workflows/*.d.ts",
      "import": "./dist/workflows/*.js",
      "default": "./dist/workflows/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run verify",
    "verify": "npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "vite-tsconfig-paths": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
