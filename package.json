{
  "name": "@polyvise/debate-engine",
  "version": "0.3.0",
  "description": "Framework-neutral multi-agent debate engine, schemas, providers, and artifact contracts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyvise/polyvise.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./debate/*": {
      "types": "./dist/debate/*.d.ts",
      "import": "./dist/debate/*.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js"
    },
    "./publishing/*": {
      "types": "./dist/publishing/*.d.ts",
      "import": "./dist/publishing/*.js"
    },
    "./workflows/*": {
      "types": "./dist/workflows/*.d.ts",
      "import": "./dist/workflows/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run verify",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "jsdom": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "vite-tsconfig-paths": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
