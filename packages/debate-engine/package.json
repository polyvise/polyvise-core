{
  "name": "@polyvise/debate-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Polyvise agent debate engine, schemas, providers, and artifact contracts.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db/*": "./src/db/*.ts",
    "./debate/*": "./src/debate/*.ts",
    "./providers/*": "./src/providers/*.ts",
    "./publishing/*": "./src/publishing/*.ts",
    "./workflows/*": "./src/workflows/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "latest",
    "postgres": "latest",
    "zod": "latest"
  }
}
